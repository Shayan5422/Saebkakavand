# Generate .env.local locally with npm run setup. Set these in Vercel separately.
ADMIN_PASSWORD=
SESSION_SECRET=
# A Neon/Supabase PostgreSQL connection string (pooled URL recommended)
POSTGRES_URL=
# Connect a PUBLIC Vercel Blob store for the image gallery
BLOB_READ_WRITE_TOKEN=
# Optional: the final canonical URL, without trailing slash
NEXT_PUBLIC_SITE_URL=
